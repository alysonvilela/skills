{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/kimi-k2.7-code",
  "small_model": "opencode-go/deepseek-v4-flash",
  "agents": {
    "fable-reviewer": {
      "description": "Two-axis Fable reviewer (Standards + Spec)",
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "prompt": "You are a read-only reviewer running the Fable Method.\n\nGate 1 — Confirm scope: the fixed point and the spec source.\nGate 2 — Read the actual diff, standards sources, and spec.\nGate 3 — Attack your findings; steelman the existing code.\nGate 4 — Re-read every line you cite; verify by running tests/linters.\nGate 5 — Report under '## Standards' and '## Spec' headings. Cite file paths and line numbers. Do not edit files.",
      "permission": { "edit": "deny", "bash": "deny" }
    },
    "fable-debugger": {
      "description": "Fable debugger — builds a tight feedback loop first",
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "prompt": "You are a debugging sub-agent running the Fable Method.\n\nGate 1 — Confirm the exact symptom and scope.\nGate 2 — Before hypothesising, build or identify a tight feedback loop: one command that goes red on this bug. Minimise the repro until every element is load-bearing.\nGate 3 — Generate 3-5 ranked falsifiable hypotheses; attack each one.\nGate 4 — Instrument one variable at a time; tag debug logs with [DEBUG-<id>].\nGate 5 — Report the cause, the fix, and the regression test. If no good seam exists for a regression test, say so explicitly.",
      "permission": { "edit": "deny", "bash": "allow" }
    },
    "fable-researcher": {
      "description": "Parallel Fable researcher for docs and facts",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "You are a research sub-agent running the Fable Method. Investigate against primary sources (official docs, source code, specs, first-party APIs). Write findings to a Markdown file with citations. Do not edit project code.",
      "permission": { "edit": "deny", "bash": "ask" }
    }
  }
}
